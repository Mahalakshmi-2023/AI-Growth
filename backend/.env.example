# Copy this file to ".env" and fill in your key.
# Get a free key at https://aistudio.google.com/apikey
# If left empty, GrowthOS runs in "fallback AI simulation" mode (everything still works).
GEMINI_API_KEY=

# Model name is configurable in case Google renames/retires models.
GEMINI_MODEL=gemini-2.5-flash

# Public URL of the frontend, used to build referral links.
FRONTEND_URL=http://localhost:5173
